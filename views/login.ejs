<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تسجيل الدخول - حجز قاعة المصادر</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-container">
    <div class="login-box">
      <div class="login-header">
        <h1>📚 قاعة المصادر التعليمية</h1>
        <p>نظام الحجز الإلكتروني</p>
      </div>

      <div class="role-toggle">
        <button type="button" class="role-btn active" data-role="teacher">
          👨‍🏫 معلم
        </button>
        <button type="button" class="role-btn" data-role="admin">
          🔧 مسؤول
        </button>
      </div>

      <% if (error) { %>
        <div class="error-msg">⚠️ <%= error %></div>
      <% } %>

      <form action="/login" method="POST" class="login-form">
        <input type="hidden" name="role" id="roleInput" value="teacher">

        <div class="form-group">
          <label for="username">اسم المستخدم</label>
          <input type="text" id="username" name="username" placeholder="أدخل اسمك" required>
        </div>

        <div class="form-group">
          <label for="password">كلمة المرور</label>
          <input type="password" id="password" name="password" placeholder="أدخل كلمة المرور" required>
        </div>

        <button type="submit" class="btn-primary">دخول</button>
      </form>
    </div>
  </div>

  <!-- حفظ الحقوق -->
  <footer class="footer">
    <p class="copyright-name">© 2026 أحمد اليعقوبي</p>
    <p>جميع الحقوق محفوظة</p>
  </footer>

  <script>
    const roleBtns = document.querySelectorAll('.role-btn');
    const roleInput = document.getElementById('roleInput');

    roleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        roleBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        roleInput.value = btn.dataset.role;
      });
    });
  </script>
</body>
</html>